def generate_random_prompt():
    base = random.choice(PROMPT_SETS)
    return base + ", simple background, professional vector aesthetic, high contrast, no text unless specified"

def generate_design():
    prompt = generate_random_prompt()
    print(f"[INFO] Using prompt: {prompt}")

    headers = {
        "Authorization": f"Bearer {API_KEY}",
        "Accept": "image/*"
    }

    # Multipart/form-data version (REQUIRED)
    files = {
        "prompt": (None, prompt),
        "aspect_ratio": (None, "1:1"),
        "output_format": (None, "png")
    }

    print("[INFO] Sending request to Stability AI...")
    response = requests.post(API_URL, headers=headers, files=files)

    if response.status_code != 200:
        print(f"[ERROR] API Error: {response.status_code} | {response.text}")
        return

    os.makedirs(os.path.dirname(SAVE_PATH), exist_ok=True)

    with open(SAVE_PATH, "wb") as f:
        f.write(response.content)

    print(f"[SUCCESS] Image saved → {SAVE_PATH}")

if __name__ == "__main__":
    generate_design()
